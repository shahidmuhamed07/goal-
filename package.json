{
  "name": "goal-path",
  "private": true,
  "version": "0.0.0",
  "description": "Goal Path monorepo: the app, the admin dashboard, the API and the types they share.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @goalpath/web",
    "dev:web": "npm run dev -w @goalpath/web",
    "dev:admin": "npm run dev -w @goalpath/admin",
    "build": "npm run build -w @goalpath/web",
    "build:admin": "npm run build -w @goalpath/admin",
    "lint": "npm run lint --workspaces --if-present"
  }
}
