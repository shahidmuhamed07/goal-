# Copy this file to `.env` (same folder) and fill it in. `.env` is ignored by git.
# NEVER commit the real file, and never paste its contents into a chat or an issue.

# Where content is stored: "mongo" (real) or "memory" (lost on restart; for a quick demo).
STORE=mongo

# Atlas: Connect → Drivers → Node.js. Replace <password> with yours, URL-encoded
# (for example "@" becomes "%40"). Add the database name after the host, as below.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=goalpath

# The port the API listens on.
PORT=3002

# Websites allowed to call the API from a browser, comma separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Who may use the admin: your Google account email(s), comma separated.
# Leave empty to keep the admin open on your own machine only (it stays locked online).
ADMIN_EMAILS=

# The Firebase project that handles login. Public information; the default is right for Goal Path.
# FIREBASE_PROJECT_ID=goal-path-9f4cc

# The free Google Gemini AI that helps plan goals (https://aistudio.google.com -> Get API key).
# A secret: put it here (this file is ignored by git) and in your host's environment settings.
# Leave empty to turn the AI off; the app then uses its own fixed questions.
GEMINI_API_KEY=
# Which model to ask. Change this if Google renames or retires it.
# GEMINI_MODEL=gemini-2.5-flash
