# Copy this file to `.env` (same folder) and fill it in. `.env` is ignored by git.
# NEVER commit the real file, and never paste its contents into a chat or an issue.

# Where content is stored: "mongo" (real) or "memory" (lost on restart; for a quick demo).
STORE=mongo

# Atlas: Connect → Drivers → Node.js. Replace <password> with yours, URL-encoded
# (for example "@" becomes "%40"). Add the database name after the host, as below.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=goalpath

# The port the API listens on.
PORT=3002

# Websites allowed to call the API from a browser, comma separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
