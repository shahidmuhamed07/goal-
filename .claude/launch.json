{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-running",
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:admin"
      ],
      "port": 3001
    },
    {
      "name": "api-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "STORE=memory",
        "npm",
        "run",
        "start",
        "-w",
        "@goalpath/api"
      ],
      "port": 3002
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 3002
    }
  ]
}
